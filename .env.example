# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Site URL (share links and social preview images) ---
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SERVER ONLY (never prefix with NEXT_PUBLIC_, never commit) ---
# Needed for: GitHub import, account deletion, abuse reports.
# Supabase -> Project Settings -> API -> service_role (or Secret key)
SUPABASE_SERVICE_ROLE_KEY=
# Optional but recommended: a GitHub token with NO scopes. Raises rate limits and enables private-contribution counts.
GITHUB_TOKEN=

# --- Community links (nav and footer) ---
NEXT_PUBLIC_GITHUB_URL=https://github.com/YOUR-ORG/dev-passport
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# --- Shown on the Privacy and Terms pages ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
# Optional, e.g. "Oman". Leave empty to omit the governing-law sentence.
NEXT_PUBLIC_JURISDICTION=
